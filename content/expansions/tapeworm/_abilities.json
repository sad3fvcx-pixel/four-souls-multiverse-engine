{
  "characters-tapeworm-tapeworm": {
    "abilities": [
      {
        "trigger": "on_activate",
        "effects": [
          {
            "effect": "add_modifier",
            "stat": "loot_plays",
            "amount": 1
          }
        ],
        "description": "Play an additional loot card this turn."
      }
    ]
  },
  "loot_deck-trinkets-tapeworm-rainbow_tapeworm": {
    "abilities": [
      {
        "trigger": "on_play",
        "effects": [
          {
            "effect": "put_into_play",
            "target": "self"
          }
        ],
        "description": "This loot becomes an item under your control when it resolves."
      },
      {
        "trigger": "turn_start",
        "scope": "controller",
        "effects": [
          {
            "roll_dice": 6
          },
          {
            "if": [
              {
                "dice_greater": {
                  "value": 3
                }
              }
            ],
            "then": [
              {
                "effect": "copy_card",
                "until": "end_of_turn",
                "targets": [
                  {
                    "target_treasure": {
                      "exclude_eternal": true,
                      "exclude_source": true,
                      "as": "model"
                    }
                  }
                ],
                "target": "model"
              }
            ]
          }
        ],
        "description": "At the start of your turn, roll: 1-3 nothing; 4-6 this becomes a copy of any non-eternal item in play till the end of your turn."
      }
    ]
  },
  "monster_deck-basic_enemies-tapeworm-tapeworm": {
    "abilities": [
      {
        "trigger": "monster_killed",
        "scope": "self",
        "effects": [
          {
            "effect": "add_counter",
            "counter": "egg",
            "amount": 1,
            "target": "active_player"
          }
        ],
        "description": "When this dies put an egg counter on the active player."
      },
      {
        "trigger": "player_died",
        "scope": "any",
        "conditions": [
          {
            "player_counters": {
              "counter": "egg",
              "operator": ">=",
              "value": 1
            }
          }
        ],
        "targets": [
          {
            "event_player": {
              "as": "hatched"
            }
          }
        ],
        "effects": [
          {
            "effect": "add_counter",
            "counter": "egg",
            "clear": true,
            "target": "hatched"
          },
          {
            "effect": "place_monster",
            "target": "self"
          }
        ],
        "description": "When a player with an egg counter dies and this is in discard, remove their egg counters and put this back into an active monster slot.",
        "zone": "monster_discard"
      }
    ]
  }
}
