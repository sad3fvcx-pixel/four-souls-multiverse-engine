    {
      "id": "monster_deck-bad_events-base_game-cursed_chest",
      "name": "Cursed Chest",
      "type": "event",
      "expansion": "base_game",
      "schema_version": "1",
      "abilities": [
        {
          "trigger": "on_play",
          "effects": [
            {
              "roll_dice": 6
            },
            {
              "if": [
                {
                  "dice_less": 4
                }
              ],
              "then": [
                {
                  "effect": "deal_damage",
                  "amount": 1,
                  "target": "controller"
                }
              ]
            },
            {
              "if": [
                {
                  "and": [
                    {
                      "dice_greater": 3
                    },
                    {
                      "dice_less": 6
                    }
                  ]
                }
              ],
              "then": [
                {
                  "effect": "deal_damage",
                  "amount": 2,
                  "target": "controller"
                }
              ]
            },
            {
              "if": [
                {
                  "dice_equals": 6
                }
              ],
              "then": [
                {
                  "effect": "take_card",
                  "to": "treasures",
                  "shuffle": "treasure",
                  "target": {
                    "target_deck_card": {
                      "deck": "treasure",
                      "tag": "guppy",
                      "as": "guppy"
                    }
                  }
                }
              ]
            }
          ],
          "description": "Roll: 1-3 take 1 damage, 4-5 take 2 damage, 6 search the treasure deck for a Guppy item, gain it, then shuffle the treasure deck."
        }
      ],
      "metadata": {
        "text": "Roll-\n1-3: Take 1 damage.\n------------------------------\n4-5: Take 2 damage.\n------------------------------\n6: Search the treasure\ndeck for a Guppy item,\ngain it, then shuffle\nthe treasure deck.",
        "set": "Base Game",
        "deck": "Monster Deck",
        "copies": 1,
        "source_id": "monster_deck-bad_events-base_game-cursed_chest",
        "subcategory": "Bad Events",
        "version": "Original",
        "artist": "@KrystalFlamingo",
        "notes": "Unlocked via The Dark Room stretch goal in the original Kickstarter."
      }
    },
