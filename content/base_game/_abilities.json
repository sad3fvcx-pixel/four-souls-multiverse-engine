  "loot_deck-cards_miscellaneous-base_game-x_wheel_of_fortune": {
    "abilities": [
      {
        "trigger": "on_play",
        "effects": [
          {
            "roll_dice": 6
          },
          {
            "if": [{"dice_equals": 1}],
            "then": [{"gain_coins": 1}]
          },
          {
            "if": [{"dice_equals": 2}],
            "then": [
              {"effect": "deal_damage", "amount": 2, "target": "controller"}
            ]
          },
          {
            "if": [{"dice_equals": 3}],
            "then": [{"draw_loot": 3}]
          },
          {
            "if": [{"dice_equals": 4}],
            "then": [{"lose_coins": 4}]
          },
          {
            "if": [{"dice_equals": 5}],
            "then": [{"gain_coins": 5}]
          },
          {
            "if": [{"dice_equals": 6}],
            "then": [{"gain_treasure": 1}]
          }
        ],
        "description": "Roll: 1 gain 1¢, 2 take 2 damage, 3 loot 3, 4 lose 4¢, 5 gain 5¢, 6 gain +1 treasure."
      }
    ]
  },

  "loot_deck-cards_miscellaneous-base_game-xvi_the_tower": {
    "abilities": [
      {
