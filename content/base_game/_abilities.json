          },
          {
            "if": [{"dice_greater": 4}],
            "then": [
              {"effect": "deal_damage", "amount": 2, "target": "all_players"}
            ]
          }
        ],
        "description": "Roll: 1-2 each player takes 1 damage, 3-4 each monster takes 1 damage, 5-6 each player takes 2 damage."
      }
    ]
  },

