            "then": [{"gain_treasure": 1}]
          }
        ],
        "description": "Roll: 1 gain 1¢, 2 take 2 damage, 3 loot 3, 4 lose 4¢, 5 gain 5¢, 6 gain +1 treasure."
      }
    ]
  },

