        "effects": [
          {
            "roll_dice": 6
          },
          {
            "if": [{"dice_less": 3}],
            "then": [
              {"effect": "deal_damage", "amount": 1, "target": "all_players"}
            ]
          },
          {
            "if": [{"and": [{"dice_greater": 2}, {"dice_less": 5}]}],
            "then": [
